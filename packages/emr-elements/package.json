{
  "name": "@drguptavivek/emr-elements",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "@drguptavivek/emr-controller": "workspace:*"
  },
  "devDependencies": {
    "@drguptavivek/emr-controller": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
