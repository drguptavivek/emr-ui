{
  "name": "@drguptavivek/emr-react",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.mjs",
      "browser": "./dist/index.web.mjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "tokens": "node scripts/generate-tokens.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "harness:next": "next dev harness/next --port 3300",
    "harness:build": "next build harness/next",
    "harness:expo": "expo start harness/expo",
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit"
  },
  "peerDependencies": {
    "@drguptavivek/emr-controller": "workspace:*",
    "react": "^19.3.0",
    "react-native": ">=0.88"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@drguptavivek/emr-controller": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "expo": "~58.0.14",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4"
  }
}
